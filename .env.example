# mock (default: demo + tests) | supabase (real backend)
VITE_DATA_SOURCE=mock
VITE_SUPABASE_URL=https://ruang-kpr.firdiaudi.my.id
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Peta lokasi properti (geoapify.com, free 3.000 kredit/hari). Public key: batasi per HTTP referrer di dashboard
# Geoapify (domain app + localhost). Kosong = peta disembunyikan, hanya link Google Maps.
VITE_GEOAPIFY_KEY=
# Never prefix the secret key with VITE_: only server-side scripts and Edge Functions may read it.
SUPABASE_SECRET_KEY=
