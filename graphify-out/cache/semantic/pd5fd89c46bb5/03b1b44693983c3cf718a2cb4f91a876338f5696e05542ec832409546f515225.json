{"nodes": [{"id": "ruangkpr_docs_03_financial_calculation_spec", "label": "03 Financial Calculation Spec", "file_type": "document", "source_file": "ruangkpr-docs/03-FINANCIAL-CALCULATION-SPEC.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The numbers contract: UI may format/hide but must never recompute with a different formula."}, {"id": "ruangkpr_docs_03_financial_calculation_spec_pure_function_principle", "label": "Pure calculation functions (no Date.now/DOM/API/mutation)", "file_type": "rationale", "source_file": "ruangkpr-docs/03-FINANCIAL-CALCULATION-SPEC.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic, testable in Node; callers pass asOf. Spec suggests src/lib/financialCalculations.js; implemented in src/calculations/finance.js."}, {"id": "ruangkpr_docs_03_financial_calculation_spec_money_rate_representation", "label": "Integer Rupiah & basis-points representation", "file_type": "rationale", "source_file": "ruangkpr-docs/03-FINANCIAL-CALCULATION-SPEC.md", "source_location": "\u00a72.1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No decimal/finance library; safe integers on native Number; rate as annualRateBps (550 = 5.50%)."}, {"id": "ruangkpr_docs_03_financial_calculation_spec_rounding_policy", "label": "Rounding policy (roundMoney at output boundary, unrounded internal balances)", "file_type": "rationale", "source_file": "ruangkpr-docs/03-FINANCIAL-CALCULATION-SPEC.md", "source_location": "\u00a72.2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prevents rounding accumulation; last row reconciles to zero."}, {"id": "ruangkpr_docs_03_financial_calculation_spec_reconciliation_invariants", "label": "Schedule reconciliation invariants", "file_type": "concept", "source_file": "ruangkpr-docs/03-FINANCIAL-CALCULATION-SPEC.md", "source_location": "\u00a72.3", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ruangkpr_docs_03_financial_calculation_spec_calculationerror", "label": "CalculationError", "file_type": "concept", "source_file": "ruangkpr-docs/03-FINANCIAL-CALCULATION-SPEC.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Functions throw structured errors instead of returning sentinel NaN/Infinity/0."}, {"id": "ruangkpr_docs_03_financial_calculation_spec_error_codes", "label": "CalculationError codes (INVALID_TYPE \u2026 DIVISION_BY_ZERO)", "file_type": "concept", "source_file": "ruangkpr-docs/03-FINANCIAL-CALCULATION-SPEC.md", "source_location": "\u00a73", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ruangkpr_docs_03_financial_calculation_spec_calculateannuitypayment", "label": "calculateAnnuityPayment()", "file_type": "concept", "source_file": "ruangkpr-docs/03-FINANCIAL-CALCULATION-SPEC.md", "source_location": "\u00a74-5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses log1p/expm1 for stability at very small rates; r = 0 \u2192 P/n."}, {"id": "ruangkpr_docs_03_financial_calculation_spec_calculateoutstanding", "label": "calculateOutstanding()", "file_type": "concept", "source_file": "ruangkpr-docs/03-FINANCIAL-CALCULATION-SPEC.md", "source_location": "\u00a76", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single-rate constant-payment only; if payment ever changed use official outstanding or full rate-period replay."}, {"id": "ruangkpr_docs_03_financial_calculation_spec_solveannualratebps", "label": "solveAnnualRateBps() \u2014 bounded bisection", "file_type": "concept", "source_file": "ruangkpr-docs/03-FINANCIAL-CALCULATION-SPEC.md", "source_location": "\u00a77", "source_url": null, "captured_at": null, "auth