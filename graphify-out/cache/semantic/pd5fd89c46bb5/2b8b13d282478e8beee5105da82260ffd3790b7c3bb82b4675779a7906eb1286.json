{"nodes": [{"id": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design", "label": "Spec: Setup KPR Berjalan 3 Step (Reminder Floating)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-01-kpr-berjalan-3-step-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design_kpr_berjalan_3_step_setup", "label": "KPR Berjalan 3-Step Reminder Setup", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-kpr-berjalan-3-step-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turns /monitoring/setup into a reminder tool (esp. before fixed->floating) that beginners finish without bank documents: steps KPR kamu, Bunga, Reminder; 5 required + 3 optional fields; percent 10/45/75 like the application wizards."}, {"id": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design_one_data_one_place", "label": "Satu data, satu tempat (single input location)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-kpr-berjalan-3-step-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No question answered in one step is asked again elsewhere; every field (bankName, rate, finance, property, reminders) has exactly one input location."}, {"id": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design_lengkapi_nanti", "label": "Lengkapi nanti (complete-later prompts)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-kpr-berjalan-3-step-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Features (KPR Health, amortization, LTV/top-up, Take Over simulation) are not removed; when data is missing they show a 'Lengkapi' link to the single place that field is asked, exactly when the feature needs it."}, {"id": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design_derived_outstanding_principal", "label": "Derived sisa pinjaman (never asked)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-kpr-berjalan-3-step-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setup never asks outstanding principal; the mock API computes it from cicilan, bunga and sisa tenor via calculateMaxPrincipal. An official figure (outstandingEstimated=false) wins until cleared; recomputed only when an input changes so older estimates stay stable."}, {"id": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design_mock_api_mortgage_rules", "label": "Mock API mortgage rules (saveSetupStep/update/activate)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-kpr-berjalan-3-step-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rules 1-8: derived outstanding, official outstanding, floating/null clears fixed-only fields, setupStep capped at 3, OFFICIAL_OUTSTANDING_REQUIRED removed from saveSetupStep, activate needs only bank/cicilan/dueDay (+fixedUntil) and valid reminders, profile finance sync, legacy fields untouched."}, {"id": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design_empty_data_tolerant_derive", "label": "Empty-data-tolerant derive.js", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-kpr-berjalan-3-step-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Minimal reminder-only KPRs must not yield NaN or fake values: rateMode null for unknown type, paidRatio null without principal, healthScore null with 'Belum lengkap', paymentWindow without startDate filter."}, {"id": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design_rate_type_unknown", "label": "Rate type 'Belum tahu' (currentRateType null)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-kpr-berjalan-3-step-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Beginners may not know their rate type; payment reminders still activate, no made-up 'normal' rate score, and Home asks to fill the rate type later."}, {"id": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design_legacy_draft_compat", "label": "Legacy 6-step draft compatibility (no schema migration)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-kpr-berjalan-3-step-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saved drafts and active KPRs stay readable without schemaVersion migration: /monitoring/setup/4..6 redirect to 3, setupStep > 3 read as 3 everywhere a draft resumes."}, {"id": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design_profile_finance_sync", "label": "Profile finance sync to mortgages", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-kpr-berjalan-3-step-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "profile.update merges finance into draft/active mortgages so KPR Health stops reading a stale income copy; db.finance is the one source."}], "edges": [{"source": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design", "target": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-01-kpr-berjalan-3-step-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_10_01_kpr_berjalan_3_step_design", "target": "docs_sup