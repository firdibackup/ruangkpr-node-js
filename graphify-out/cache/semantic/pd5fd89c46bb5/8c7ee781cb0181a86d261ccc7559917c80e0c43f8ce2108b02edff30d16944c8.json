{"nodes": [{"id": "docs_superpowers_specs_2026_10_01_takeover_wizard_3_tahap_design", "label": "Spec: Wizard Take Over & Refinancing 3 Tahap", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-01-takeover-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_01_takeover_wizard_3_tahap_design_takeover_phase_progress", "label": "Take Over 9-screen / 3-phase progress", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-takeover-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "9 progress screens mapped onto phases Kamu & KPR Lama, Kondisi & Tujuan, Pilih Bank & Kirim with percents 10..95; phase ends land on the same 45% / 75% as Primary. Routes, autosave, currentStep and the Explore simulation flow unchanged."}, {"id": "docs_superpowers_specs_2026_10_01_takeover_wizard_3_tahap_design_currentstep_screen_mapping", "label": "currentStep to furthest screen mapping", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-takeover-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "currentStep 1..7 maps to screens 1,3,4,5,6,7|8,9; step 6 depends on whether a program selection exists."}, {"id": "docs_superpowers_specs_2026_10_01_takeover_wizard_3_tahap_design_takeover_milestone_1", "label": "Take Over Milestone 1: Tahap 1 selesai", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-takeover-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After the old loan is confirmed, shows what staying with the old bank costs (remaining interest, principal paid, rate status, payoff month). Pure client-side math from app.data and clock, so no loading or error state."}, {"id": "docs_superpowers_specs_2026_10_01_takeover_wizard_3_tahap_design_baseline_phase_two_banner", "label": "Take Over Milestone 2: Baseline 'Tahap 2 selesai' banner", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-takeover-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Milestone 2 is the existing Baseline page plus a banner (no extra screen or click), shown only when sim.source.type === 'application'; health ring + one teaser line from sim.items."}, {"id": "docs_superpowers_specs_2026_10_01_takeover_wizard_3_tahap_design_refinancing_covered", "label": "Refinancing + Top-up via the same wizard", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-takeover-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Home 'Refinancing' card opens /optimize/intro?mode=topup, which uses the Take Over wizard, so it is covered automatically."}, {"id": "docs_superpowers_specs_2026_10_01_takeover_wizard_3_tahap_design_shared_milestone_frame", "label": "Shared milestone frame", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-takeover-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The PrimaryMilestone frame (success icon, title, insight grid, disclaimer, buttons) is split into src/components/shared and used by both wizards' milestones; no new calculations or API."}], "edges": [{"source": "docs_superpowers_specs_2026_10_01_takeover_wizard_3_tahap_design", "target": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-10-01-takeover-wiz