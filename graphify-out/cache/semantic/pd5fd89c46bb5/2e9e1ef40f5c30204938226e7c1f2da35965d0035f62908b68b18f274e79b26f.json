{"nodes": [{"id": "ruangkpr_docs_01_master_prd", "label": "01 Master PRD: RuangKPR", "file_type": "document", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ruangkpr_docs_01_master_prd_ruangkpr_personal_kpr_financial_assistant", "label": "RuangKPR (Personal KPR Financial Assistant)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Positioned as a dashboard that keeps a KPR under control for its whole lifetime, not a better calculator."}, {"id": "ruangkpr_docs_01_master_prd_frontend_first_delivery_scope", "label": "Frontend-first delivery scope (Vite+React JS, shadcn/ui, mock API, pure JS calc engine)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Locked scope: build UI against mock adapter and JSON fixtures before any real backend/database/provider is chosen."}, {"id": "ruangkpr_docs_01_master_prd_know_warn_act", "label": "Know -> Warn -> Act principle", "file_type": "rationale", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L53", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Know = understand KPR state; Warn = payment reminders and fixed-to-floating early warning; Act = simulate, compare, apply to one bank."}, {"id": "ruangkpr_docs_01_master_prd_product_principles", "label": "Product principles (show less, progressive disclosure, estimate is not approval, no silent submission)", "file_type": "rationale", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L156", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Home = glance, detail = understand, compare = decide; all estimates carry disclaimers; data goes to a bank only after consent and explicit submit."}, {"id": "ruangkpr_docs_01_master_prd_deterministic_financial_math", "label": "Deterministic financial math (AI never produces authoritative numbers)", "file_type": "rationale", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L164", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rates, balances, eligibility and approval must come from the calculation engine; AI may only explain deterministic results later (see \u00a720.5)."}, {"id": "ruangkpr_docs_01_master_prd_one_application_one_bank", "label": "One application = one bank/program", "file_type": "rationale", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L163", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No multi-bank submission in MVP; matches the initial one-bank operational model."}, {"id": "ruangkpr_docs_01_master_prd_no_false_integration_claims", "label": "No false integration claims (manual payment is user-recorded)", "file_type": "rationale", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L166", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual payments must never be presented as bank-synced; trackers reflect backend status, not fake timers."}, {"id": "ruangkpr_docs_01_master_prd_five_tab_navigation", "label": "Navigation: Home | My KPR | Explore | Activity | Profile", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L173", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Static shell, dynamic content: five items always present and never disabled; content changes with lifecycle state."}, {"id": "ruangkpr_docs_01_master_prd_visual_baseline", "label": "Visual baseline (Plus Jakarta Sans, #003DA5, #F4F6FA, Command Center header)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L227", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approved Claude Design artifact is the visual source; no new shell or visual language without explicit approval."}, {"id": "ruangkpr_docs_01_master_prd_home_render_priority", "label": "Home render priority (rejected > in-process > draft > setup draft > warning > floating > normal > fresh)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L281", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MVP assumes one active application or setup draft and one active mortgage per user, so a single priority order decides Home content."}, {"id": "ruangkpr_docs_01_master_prd_application_state_machine", "label": "Application state machine (draft -> submitted -> ... -> disbursed; rejected/cancelled)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L250", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cancel pre-akad is a hard delete by current product decision; retention/regulatory requirement must be validated before production."}, {"id": "ruangkpr_docs_01_master_prd_mortgage_state_machine", "label": "Mortgage state (draft -> active -> closed)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L273", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "mortgage.draft holds unfinished monitoring setup and never creates an application."}, {"id": "ruangkpr_docs_01_master_prd_kpr_primary_application_flow", "label": "KPR Primary application flow (5 steps: product, data, documents, compare, review & submit)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L453", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Primary covers both new and used houses; no separate Secondary product, flow or engine."}, {"id": "ruangkpr_docs_01_master_prd_payment_capacity_formula", "label": "Payment capacity formula (safe payment = ratio_config x income; default 35%)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L555", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "35% is a prototype default only; ratio must be configurable per product/bank policy. Programs over capacity stay visible with warning."}, {"id": "ruangkpr_docs_01_master_prd_rule_based_bank_matching", "label": "Rule-based bank product matching and recommendation label", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L566", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not AI: recommendation only if estimated eligible, within capacity, product data current, and best by sorting objective."}, {"id": "ruangkpr_docs_01_master_prd_application_tracker", "label": "Application tracker and rejected recovery (clone to other bank / retry same bank)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L634", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ruangkpr_docs_01_master_prd_mortgage_setup_wizard", "label": "Existing KPR setup wizard (6 steps: Data KPR, Bunga & Cicilan, Properti, Keuangan, Reminder, Review)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L708", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets existing owners set up monitoring in 5-8 minutes without documents; activation flips mortgage draft to active and creates no application."}, {"id": "ruangkpr_docs_01_master_prd_payment_changed_branch", "label": "Payment-changed accuracy branch (no single-rate reverse engineering)", "file_type": "rationale", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L741", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If payment never changed the engine may solve effective rate and estimate outstanding; if it changed, official outstanding/rate/tenor are required because a single-rate solve would be wrong."}, {"id": "ruangkpr_docs_01_master_prd_rate_periods", "label": "Rate periods (fixed -> fixed -> floating; ordered, no overlap/gap)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L763", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Floating future value is always an estimate; active-period-only input is allowed but forces partial-data state for full-schedule features."}, {"id": "ruangkpr_docs_01_master_prd_home_monitoring_dashboard", "label": "Home monitoring dashboard (Health, Next Payment, Warning, Progress, Opportunity; no charts by default)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L858", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No charts on Home keeps it a 5-10 second glance. 2026-10-05 note: rule applies to the default layout only; charts (Proyeksi Sisa Pokok, Dampak Floating, Komposisi Cicilan, Pokok vs Bunga per Tahun) are opt-in widgets via Atur Dashboard -> Tambah widget."}, {"id": "ruangkpr_docs_01_master_prd_kpr_health_score", "label": "KPR Health composite score (DTI, LTV, rate risk, loan progress)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L872", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not a bank credit score; weights must be configurable and documented; incomplete inputs yield a partial score instead of false precision."}, {"id": "ruangkpr_docs_01_master_prd_fixed_to_floating_warning", "label": "Fixed-to-floating early warning (H-90/60/30/14/7)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L891", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Triggers when 0 < days_until_fixed_end <= 90; becomes the hero card showing current vs estimated floating payment delta with Stay / Compare Take Over / Request Repricing CTAs."}, {"id": "ruangkpr_docs_01_master_prd_partial_data_state", "label": "Partial-data state (missing property value or rate/outstanding)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L917", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Missing data never blocks reminders and never produces fake estimates; show explicit fields to complete."}, {"id": "ruangkpr_docs_01_master_prd_my_kpr_tabs", "label": "My KPR tabs (Overview | Payment | Rate | Property)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L932", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No new sidebar items; Rate tab shows a rate-period timeline; Property tab shows estimated equity/LTV with not-an-appraisal disclaimers."}, {"id": "ruangkpr_docs_01_master_prd_amortization_schedule", "label": "Amortization schedule (summary, annual stacked chart, monthly/yearly table, financial invariants)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L986", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Placed under My KPR -> Payment, not top-level nav. Generated from inputs, not persisted per row; cache only if measured performance needs it. Invariants: sum(principal)=opening, sum(payment)=principal+interest, final balance 0 within tolerance."}, {"id": "ruangkpr_docs_01_master_prd_explore_signals", "label": "Explore with active mortgage (Take Over floating/opportunity signals)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1061", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without an active mortgage only education cards render (not disabled). Refinancing/Multiguna badges deferred until reliable valuation rules exist."}, {"id": "ruangkpr_docs_01_master_prd_simulation_vs_application", "label": "Simulation separated from application (Simpan Simulasi vs Ajukan Sekarang)", "file_type": "rationale", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1090", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Saving a simulation never creates an application; Apply Now creates one prefilled draft, preserving no-silent-submission."}, {"id": "ruangkpr_docs_01_master_prd_take_over_flow", "label": "Take Over flow (baseline, total moving cost, break-even, old KPR settlement tracker)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1103", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Take Over is judged on total cost and break-even, not promo rate; existing users skip the cold-entry wizard."}, {"id": "ruangkpr_docs_01_master_prd_refinancing_topup", "label": "Refinancing + Top-up requirement framework", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1181", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Needs partner policy validation; no authoritative recommendation until policies exist."}, {"id": "ruangkpr_docs_01_master_prd_multiguna", "label": "Multiguna requirement framework (property-secured loan)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1228", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuse calculation engine and bank product engine with product_type=multiguna; no separate engine unless bank rules prove materially different."}, {"id": "ruangkpr_docs_01_master_prd_notification_reliability", "label": "Notification reliability (idempotent scheduling, dedupe per event/milestone/channel)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1289", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MVP channels are in-app and email; WhatsApp only once a provider exists. Reminders stop after mortgage closed or setting disabled."}, {"id": "ruangkpr_docs_01_master_prd_conceptual_data_model", "label": "Conceptual data model (users, applications, mortgages, rate_periods, properties, payments, bank_products, simulations)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1304", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ruangkpr_docs_01_master_prd_calculation_engine_requirements", "label": "Calculation engine requirements (annuity, solve-for-rate, rate periods, DTI/LTV, take over costs)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1433", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use decimal-safe money calculations, not binary float, and define rounding with final-installment reconciliation."}, {"id": "ruangkpr_docs_01_master_prd_break_even_formula", "label": "Break-even formula (moving_cost / monthly_benefit)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1466", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If monthly_benefit <= 0, never show positive break-even; label it as not reached and evaluate total-cost differences separately."}, {"id": "ruangkpr_docs_01_master_prd_bank_product_data_governance", "label": "Bank product data governance (versioned, effective dates, stale threshold)", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1481", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stale product data is a top operational risk; stale beyond threshold shows a warning or disables the recommendation label."}, {"id": "ruangkpr_docs_01_master_prd_security_privacy_consent", "label": "Security, privacy, consent and compliance requirements", "file_type": "concept", "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L1499", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never request/store bank password, PIN or banking OTP; no public document URLs; consent version and timestamp recorded."}], "edges": [{"source": "ruangkpr_docs_01_master_prd", "target": "ruangkpr_docs_04_mock_api_json_contract", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L25", "weight": 1.0}, {"source": "ruangkpr_docs_01_master_prd", "target": "ruangkpr_docs_02_frontend_functional_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L25", "weight": 1.0}, {"source": "ruangkpr_docs_01_master_prd", "target": "ruangkpr_docs_03_financial_calculation_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ruangkpr-docs/01-MASTER-PRD.md", "source_location": "L25", "weight": 1.0}, {"source": "ruangkpr_docs_01_master_prd", "target": "ruangkpr_docs_05_frontend_architecture_delivery", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "ruangkpr-docs/