{"nodes": [{"id": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design", "label": "Spec: Wizard KPR Primary 3 Tahap + Milestone", "file_type": "document", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design_three_phase_grouping", "label": "3-phase grouping (group, not merge screens)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "7 short screens grouped into 3 phases (Tentang Kamu, Rumah & Pinjaman, Pilih Bank & Kirim) so the form feels lighter, while routes, autosave, currentStep, relevantStep and resumePath stay unchanged."}, {"id": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design_front_loaded_percent", "label": "Front-loaded rounded progress percent", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Percent rounded to multiples of 5 and fast early (10,30,45,60,75,85,95) so the user feels far along; phase ends at 45% / 75%."}, {"id": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design_milestone_insight_screen", "label": "Milestone insight screen", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each phase closes with a separate screen (not a card or dialog) rewarding the user with real numbers from the bank catalog, only when they can be computed."}, {"id": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design_milestone_replace_navigation", "label": "Milestone via location.state + replace navigation", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Save navigates with state {milestone}; 'Lanjut ke Tahap N' navigates with replace and no state, so browser back/reload from the next form never re-shows the milestone; not shown when editing from Review or resuming a draft."}, {"id": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design_furthest_screen_progress", "label": "Progress from furthest saved screen", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bar and percent use max(open screen, currentStep) so stepping back to edit never lowers progress."}, {"id": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design_affordability_milestone", "label": "Primary Milestone 1: Affordability insights", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cicilan aman, Plafon KPR hingga, Harga rumah hingga, open-program chip via api.bankProducts.affordability. Uses the fixed rate because the first installment in generateAmortizationSchedule is a fixed-rate annuity over the full tenor, the same thing comparePrimaryPrograms judges (withinCapacity)."}, {"id": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design_match_milestone", "label": "Primary Milestone 2: Matching programs insights", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Program cocok, Cicilan mulai, Rasio cicilan vs 35% capacity from the existing api.bankProducts.compare; no new function."}, {"id": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design_open_program_rule", "label": "Open bank program eligibility rule", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Active and valid at asOf, productTypes includes primary, income >= minimumIncome, occupation allowed, age >= minimumAge, max tenor = min(maximumTenorMonths, (maximumAgeAtMaturity - age) x 12) >= 12; property type and LTV unknown at this phase so not filtered."}, {"id": "docs_superpowers_specs_2026_10_01_primary_wizard_3_tahap_design_ballpark_rounding", "label": "Ballpark rounding (floor to Rp10 jt with \u00b1)", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plafon and house price shown floored to Rp10 jt with a \u00b1 prefix; rounding is display-only, calculation functions keep exact rupiah."}, {"id": "src_calculations_programs_primaryaffordability", "label": "primaryAffordability()", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_calculations_finance_calculatepaymentcapacity", "label": "calculatePaymentCapacity()", "file_type": "code", "source_file": "docs/superpowers/specs/2026-10-01-primary-wizard-3-tahap-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"